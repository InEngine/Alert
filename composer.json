{
    "name": "inengine/alert",
    "description": "In App Alert Notifications for Laravel/InEngine Applications",
    "keywords": [
        "InEngine",
        "laravel",
        "alert"
    ],
    "version": "1.0.4",
    "homepage": "https://github.com/inengine/alert",
    "license": "MIT",
    "authors": [
        {
            "name": "James Johnson",
            "email": "james.johnson@excellentingenuity.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/contracts": "^12.0||^13.0",
        "inengine/modulus": "^0.1@beta",
        "laravel/prompts": "^0.3.14",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "livewire/livewire": "^4.4",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^11.2.0||^10.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "replace": {
        "mbarlow/megaphone": "^2.3.0"
    },
    "autoload": {
        "psr-4": {
            "InEngine\\Alert\\": "src/",
            "InEngine\\Alert\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "InEngine\\Alert\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "provide": {
        "inengine/cap-alerts-dispatch": "*",
        "inengine/cap-alerts-livewire-bell": "*",
        "inengine/cap-alerts-has-alerts": "*",
        "inengine/cap-alerts-artisan-send": "*",
        "inengine/cap-alerts-type-general": "*",
        "inengine/cap-alerts-type-urgent": "*",
        "inengine/cap-alerts-type-important": "*",
        "inengine/cap-alerts-type-task": "*",
        "inengine/cap-alerts-type-info": "*"
    },
    "extra": {
        "laravel": {
            "providers": [
                "InEngine\\Alert\\AlertServiceProvider"
            ],
            "aliases": {
                "Alert": "InEngine\\Alert\\Facades\\Alert"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
